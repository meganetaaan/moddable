{
	"build": {
		"ESP32_SUBCLASS": "esp32p4",
		"ESP32P4_HWVER": "hw_ver1",
		"C_FLAGS_SUBPLATFORM": "-DkPocoFrameBuffer=1",
		"USE_USB": "2",
		"SDKCONFIGPATH": "./sdkconfig",
		"PARTITIONS_FILE_FOR_TARGET": "./sdkconfig/partitions.csv",
		"PROGRAMMING_MODE_MESSAGE": "INSTRUCTIONS: Hold RESET, hold BOOT, release RESET, then release BOOT.",
		"BEFORE_DEBUGGING_MESSAGE": "Press and release RESET."
	},
	"include": [
		"$(MODULES)/io/manifest.json",
		"$(MODULES)/io/audioin/manifest.json",
		"$(MODULES)/io/audioout/manifest.json",
		"$(MODULES)/io/expander/manifest_pi4ioe5v6408.json",
		"$(MODULES)/io/display/manifest.json",
		"$(MODULES)/io/files/sdmmc/manifest.json",
		"$(MODULES)/drivers/peripherals/es7210/manifest.json",
		"$(MODULES)/drivers/peripherals/es8388/manifest.json",
		"$(MODULES)/drivers/peripherals/rx8130ce/manifest.json",
		"$(MODULES)/drivers/sensors/bmi270/manifest.json",
		"$(MODULES)/drivers/sensors/gt911/manifest.json",
		"$(MODULES)/drivers/sensors/ina226/manifest.json",
		"$(MODULES)/drivers/sensors/st712x/manifest.json"
	],
	"modules": {
		"embedded:display/m5stack-tab5": "$(MODULES)/io/display/display",
		"m5stack-tab5/board": "./board",
		"setup/target": "./setup-target",
		"*": "./display"
	},
	"preload": [
		"embedded:display/m5stack-tab5",
		"m5stack-tab5/board",
		"setup/target"
	],
	"config": {
		"format": "RGB565LE",
		"rotation": 90,
		"brightness": 100,
		"touchCount": 5,
		"files": "/sdcard",
		"filesSymlinks": false
	},
	"creation": {
		"static": 0,
		"chunk": {
			"initial": 78848,
			"incremental": 0
		},
		"heap": {
			"initial": 4928,
			"incremental": 0
		},
		"stack": 512
	},
	"defines": {
		"audioIn": {
			"sampleRate": 48000,
			"bitsPerSample": 16,
			"numChannels": 2,
			"i2s": {
				"num": 0,
				"slot": "I2S_STD_SLOT_BOTH",
				"format_i2s": 1,
				"bck_pin": 27,
				"lr_pin": 29,
				"mck_pin": 30,
				"datain": 28
			}
		},
		"audioOut": {
			"sampleRate": 48000,
			"bitsPerSample": 16,
			"numChannels": 1,
			"i2s": {
				"num": 0,
				"slot": "I2S_STD_SLOT_BOTH",
				"format_i2s": 1,
				"bitsPerSample": 16,
				"bck_pin": 27,
				"lr_pin": 29,
				"mck_pin": 30,
				"dataout_pin": 26
			}
		},
		"wifi": {
			"remote": 1
		},
		"file": {
			"sdmmc": {
				"slot": 0,
				"width": 4,
				"max_files": 5,
				"ldo": 4,
				"clk": 43,
				"cmd": 44,
				"d0": 39,
				"d1": 40,
				"d2": 41,
				"d3": 42
			}
		}
	},
	"platforms": {
		"esp32": {
			"dependency": [
				{ "idf": "esp_lcd" },
				{ "idf": "esp_hw_support" },
				{ "name": "esp_lcd_ili9881c", "version": "^1.1.0" },
				{ "name": "esp_lcd_st7121", "version": "^1.0.1" },
				{ "name": "esp_lcd_st7123", "version": "^1.0.2" }
			]
		}
	}
}
