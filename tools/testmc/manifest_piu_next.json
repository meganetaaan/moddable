{
	"include": [
		"./manifest.json",
		"$(MODDABLE)/examples/manifest_typings.json"
	],
	"modules": {
		"*": [
			"$(MODDABLE)/contributed/piu-next/src/*"
		],
		"counterMain": "$(MODDABLE)/contributed/piu-next/examples/counter-app/src/main"
	},
	"resources": {
		"*-mask": [
			"$(MODDABLE)/examples/assets/fonts/OpenSans-Semibold-28",
			"$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-52",
			"$(MODDABLE)/examples/assets/fonts/OpenSans-Semibold-20",
			"$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-18"
		]
	}
}
