				{
					"name": "usb_host_hid",
					"version": "==1.2.0",
					"includes": ["include"]
				}
			]
		},
		"...": {
			"error": "USB HID host is only available on M5Stack Tab5"
		}
	},
	"preload": [
		"embedded:io/usb/hid"
	]
}
