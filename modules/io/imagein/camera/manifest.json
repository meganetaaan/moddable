{
	"preload": [
		"embedded:io/image/in/camera"
	],
	"platforms": {
		"mac": {
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": "./mac/camera",
				"commodetto/Convert": "$(MODDABLE)/modules/commodetto/commodettoConvert"
			}
		},
		"lin": {
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": "./lin/camera",
				"commodetto/Convert": "$(MODDABLE)/modules/commodetto/commodettoConvert"
			}
		},
		"win": {
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": "./win/camera",
				"commodetto/Convert": "$(MODDABLE)/modules/commodetto/commodettoConvert"
			}
		},
		"esp32": {
			"modules": {
				"*": "$(MODDABLE)/modules/io/common/builtinCommon",
				"embedded:io/image/in/camera": "./esp32/camera"
			},
			"dependency": [ {
				"name": "esp32-camera",
				"version": "^2.0.10",
				"includes": [
					"conversions/include",
					"driver/include"
				]
			},
			{
				"name": "esp_jpeg",
				"version": "^1.3.1"
			}]
		},
		"esp32/m5stack_tab5": {
			"modules": {
				"*": [
					"$(MODDABLE)/modules/io/common/builtinCommon",
					"./esp32p4/camera.c"
				],
				"embedded:io/image/in/camera": "./esp32/camera.js"
			},
			"dependency": [
				{ "idf": "esp_driver_ppa" },
				{
					"name": "esp_video",
					"version": "==2.0.1",
					"includes": ["include"]
				},
				{
					"name": "esp_ipa",
					"version": "==1.3.1",
					"includes": ["include"]
				},
				{
					"name": "esp_cam_sensor",
					"version": "==2.0.1"
				}
			]
		},
		"pico": {
		},
		"...": {
			"error": "Experimental TC53 IO modules"
		}
	}
}
