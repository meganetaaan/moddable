{
	"platforms": {
		"esp32": {
			"modules": {
				"embedded:network/interface/wifi": "./wifi-esp32"
			},
			"preload": [
				"embedded:network/interface/wifi"
			],
			"dependency": [
				{ "idf": "esp_wifi" }
			]
		},
		"esp32/m5stack_tab5": {
			"modules": {
				"embedded:network/interface/wifi": "./wifi-esp32"
			},
			"preload": [
				"embedded:network/interface/wifi"
			],
			"dependency": [
				{ "idf": "esp_wifi" },
				{ "name": "esp_hosted", "version": "==2.12.11", "includes": ["host", "host/api/include"] },
				{ "name": "esp_wifi_remote", "version": "==1.3.1", "includes": ["idf_v6.0/include", "idf_v6.0/include/injected"] }
			]
		}
	}
}
