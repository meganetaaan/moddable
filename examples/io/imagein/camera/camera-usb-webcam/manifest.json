{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"./manifest_usb.json"
	],
	"platforms": {
		"esp32/m5stack_cores3": {
			"modules": {
				"*": ["./main", "./webcam"]
			},
			"config": {
				"startupSound": false
			},
			"dependency": [
				{
					"name": "esp32-camera",
					"version": "==2.1.9",
					"includes": ["driver/include", "conversions/include"]
				},
				{ "name": "esp_jpeg", "version": "^1.3.1" },
				{ "name": "usb_device_uvc", "version": "==1.3.1" }
			],
			"esp32Config": {
				"CONFIG_ESP_CONSOLE_SECONDARY_NONE": "y",
				"CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG": "n",
				"CONFIG_FRAMESIZE_QVGA": "y",
				"CONFIG_FORMAT_MJPEG_CAM1": "y",
				"CONFIG_UVC_MODE_ISOC_CAM1": "y",
				"CONFIG_UVC_CAM1_MULTI_FRAMESIZE": "n",
				"CONFIG_UVC_CAM1_FRAMERATE": "10",
				"CONFIG_TUSB_PRODUCT": "\"M5Stack CoreS3 Webcam\""
			}
		},
		"...": {
			"error": "This example requires M5Stack CoreS3"
		}
	}
}
